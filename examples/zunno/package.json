{
  "name": "swaraj-zunno",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Swaraj-governed AI agent for Zunno: every agent move is checked against an Agent Mandate before it executes.",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "e2e:gateway": "tsx src/e2e/gatewayWager.ts",
    "play": "tsx src/play.ts",
    "vectors": "tsx scripts/gen-vectors.ts",
    "lean:sync": "node lean/scripts/sync-vectors.mjs",
    "check:lean": "cd lean && $HOME/.elan/bin/lake build",
    "settle": "tsx src/swaraj/settleCli.ts"
  },
  "dependencies": {
    "@neardefi/shade-agent-js": "2.2.0",
    "@noble/hashes": "^1.8.0",
    "@phala/dcap-qvl-node": "0.3.3",
    "@swaraj/agent": "workspace:*",
    "@swaraj/rules": "workspace:*",
    "@swaraj/schemas": "workspace:*",
    "near-api-js": "^7.4.0",
    "viem": "^2.57.13",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
