{
  "mandateId": "zunno_mandate_v1",
  "version": 2,
  "agent": "zunno-agent",
  "defaultEffect": "DENY",
  "validFrom": 1789990000000,
  "validUntil": 1900000000000,
  "rules": [
    {
      "ruleId": "a_forbid_wild_draw_four",
      "effect": "FORBID",
      "action": "APP_ACTION",
      "predicates": [
        { "field": "context.name", "operator": "EQ", "value": "play_card" },
        { "field": "context.param", "name": "cardValue", "operator": "GT", "value": "104" }
      ]
    },
    {
      "ruleId": "a_permit_game_actions",
      "effect": "PERMIT",
      "action": "APP_ACTION",
      "predicates": [
        { "field": "resource.app", "operator": "EQ", "value": "zunno" },
        { "field": "context.name", "operator": "IN", "values": ["draw_card", "play_card"] },
        { "field": "context.paramBool", "name": "onTurn", "operator": "EQ", "value": true }
      ]
    },
    {
      "ruleId": "forbid_off_turn",
      "effect": "FORBID",
      "action": "APP_ACTION",
      "predicates": [
        { "field": "context.paramBool", "name": "onTurn", "operator": "EQ", "value": false }
      ]
    },
    {
      "ruleId": "forbid_stake_over_cap",
      "effect": "FORBID",
      "action": "PAYMENT",
      "predicates": [
        { "field": "context.amount", "operator": "GT", "value": "10000000000000000" }
      ]
    },
    {
      "ruleId": "forbid_wager_over_cap",
      "effect": "FORBID",
      "action": "PAYMENT",
      "predicates": [
        { "field": "resource.service", "operator": "EQ", "value": "zunno_wager" },
        { "field": "context.amount", "operator": "GT", "value": "5000000" }
      ]
    },
    {
      "ruleId": "permit_stake_eth_in_cap",
      "effect": "PERMIT",
      "action": "PAYMENT",
      "predicates": [
        { "field": "context.amount", "operator": "LTE", "value": "10000000000000000" },
        { "field": "context.currency", "operator": "EQ", "value": "ETH" },
        { "field": "context.recipient", "operator": "EQ", "value": "0x82b2cce9a52c7e56838a5c46833067f9eb006911" }
      ]
    },
    {
      "ruleId": "permit_wager_near_in_cap",
      "effect": "PERMIT",
      "action": "PAYMENT",
      "predicates": [
        { "field": "resource.service", "operator": "EQ", "value": "zunno_wager" },
        { "field": "context.amount", "operator": "LTE", "value": "5000000" },
        { "field": "context.currency", "operator": "EQ", "value": "USDC" }
      ]
    }
  ]
}
