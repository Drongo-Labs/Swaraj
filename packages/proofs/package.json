{
  "name": "@swaraj/proofs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @swaraj/database... build && pnpm --filter @swaraj/smt... build && pnpm build && node --env-file ../../.env --test --test-concurrency 1 scripts/*.test.ts",
    "check:rust": "cargo test --manifest-path engine/Cargo.toml",
    "check:sp1-host": "cargo check --manifest-path host/Cargo.toml",
    "build:sp1": "cd guest && cargo prove build --docker --tag v5.2.4 --workspace-directory .. --output-directory ../artifacts --elf-name swaraj-gate-guest",
    "execute:sp1": "cargo run --release --manifest-path host/Cargo.toml -- artifacts/swaraj-gate-guest",
    "prove:sp1": "cargo run --release --manifest-path host/Cargo.toml -- artifacts/swaraj-gate-guest --prove",
    "worker:once": "pnpm build && node --env-file ../../.env scripts/run-worker-once.mjs"
  },
  "dependencies": {
    "@swaraj/database": "workspace:*",
    "@swaraj/smt": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
