      "predicates": [
        {
          "field": "context.amount",
          "operator": "GT",
          "value": "10000000000000000000000"
        }
      ]
    },
    {
      "ruleId": "permit_near_live_transfer",
      "effect": "PERMIT",
      "action": "PAYMENT",
      "predicates": [
        {
          "field": "resource.service",
          "operator": "EQ",
          "value": "near_transfer"
        },
        {
          "field": "context.currency",
          "operator": "EQ",
          "value": "NEAR"
        }
      ]
    }
  ]
