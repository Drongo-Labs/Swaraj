{
  "mandateId": "mandate_near_combined_v1",
  "version": 1,
  "agent": "*",
  "defaultEffect": "DENY",
  "validFrom": 0,
  "validUntil": 4102444800000,
  "rules": [
    {
      "ruleId": "forbid_near_payment_amount",
      "effect": "FORBID",
      "action": "PAYMENT",
      "predicates": [
        {
          "field": "context.amount",
          "operator": "GT",
          "value": "5000000"
        }
      ]
    },
    {
      "ruleId": "forbid_near_trade_amount",
      "effect": "FORBID",
      "action": "SPOT_TRADE",
      "predicates": [
        {
          "field": "context.amount",
          "operator": "GT",
          "value": "100000000"
        }
      ]
    },
    {
      "ruleId": "permit_near_payment",
      "effect": "PERMIT",
      "action": "PAYMENT",
      "predicates": [
        {
          "field": "resource.service",
          "operator": "EQ",
          "value": "near_ft_transfer"
        },
        {
          "field": "context.currency",
          "operator": "IN",
          "values": ["NEAR", "USDC"]
        }
      ]
    },
    {
      "ruleId": "permit_near_trade_venue",
      "effect": "PERMIT",
      "action": "SPOT_TRADE",
      "predicates": [
        {
          "field": "resource.venue",
          "operator": "EQ",
          "value": "REF_FINANCE_NEAR"
        }
      ]
    }
  ]
}
