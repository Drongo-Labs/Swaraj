{
  "name": "swaraj",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm build && pnpm -r typecheck && pnpm -r --if-present test",
    "example": "pnpm --filter @swaraj/example... build && pnpm --filter @swaraj/example start --demo",
    "agent": "pnpm --filter @swaraj/example... build && pnpm --filter @swaraj/example start --live",
    "dev:api": "pnpm --filter @swaraj/api... build && pnpm --filter @swaraj/api start",
    "dev:web": "pnpm --filter @swaraj/web dev",
    "check:rust": "pnpm --filter @swaraj/proofs check:rust",
    "check:sp1-host": "pnpm --filter @swaraj/proofs check:sp1-host",
    "check:lean": "pnpm --filter @swaraj/lean check:lean",
    "check:all": "pnpm check && pnpm check:rust && pnpm check:lean",
    "build:sp1": "pnpm --filter @swaraj/proofs build:sp1",
    "execute:sp1": "pnpm --filter @swaraj/proofs execute:sp1",
    "prove:sp1": "pnpm --filter @swaraj/proofs prove:sp1",
    "db:up": "docker compose up -d postgres",
    "test:phase8": "pnpm --filter @swaraj/proofs test:phase8",
    "test:phase9": "pnpm --filter @swaraj/proofs test:phase9",
    "proofs:prove": "pnpm --filter @swaraj/proofs prover:once",
    "proofs:worker": "pnpm --filter @swaraj/proofs worker:once",
    "proofs:worker:decision": "pnpm --filter @swaraj/proofs worker:decision:once"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
