{
  "name": "swaraj",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm build && pnpm typecheck && pnpm test",

    "demo": "pnpm --filter @swaraj/example... build && pnpm --filter @swaraj/example start --demo",
    "live": "pnpm --filter @swaraj/example... build && pnpm --filter @swaraj/example start --live",
    "dev:api": "pnpm --filter @swaraj/api... build && pnpm --filter @swaraj/api start",
    "dev:web": "pnpm --filter @swaraj/web dev",
    "dev:mcp": "pnpm --filter @swaraj/mcp start",

    "db:up": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",

    "check:all": "pnpm check && pnpm check:rust && pnpm check:lean",
    "check:rust": "pnpm --filter @swaraj/proofs check:rust",
    "check:lean": "pnpm --filter @swaraj/lean check:lean",
    "build:sp1": "pnpm --filter @swaraj/proofs build:sp1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
