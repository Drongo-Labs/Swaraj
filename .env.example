# ──────────────────────────────────────────────────────────────────────
# Swaraj environment template.
# Copy to .env and fill in real values. .env is gitignored; never commit it.
# ──────────────────────────────────────────────────────────────────────

# Local Postgres (compose.yaml). The connection string below must stay
# consistent with these three values.
POSTGRES_USER=swaraj
POSTGRES_DB=swaraj
POSTGRES_PASSWORD=choose-a-local-dev-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://swaraj:choose-a-local-dev-password@127.0.0.1:5432/swaraj

# Backend service the SDK / MCP bridge talks to.
SWARAJ_URL=http://127.0.0.1:3000
SWARAJ_DEV_TOKEN=replace-with-32-random-characters
SWARAJ_AGENT_KEY=replace-with-32-random-characters
SWARAJ_APPLICATION_ID=app_demo

# Execution venue: Base mainnet or Base Sepolia. Pick exactly one pair.
SWARAJ_BASE_NETWORK=base
BASE_RPC_URL=https://mainnet.base.org
# SWARAJ_BASE_NETWORK=base-sepolia
# BASE_RPC_URL=https://sepolia.base.org

# Signing / execution keys. Fund a dedicated test wallet; never reuse keys.
SWARAJ_EXECUTION_PRIVATE_KEY=0x...
SWARAJ_SIGNER_PRIVATE_KEY=0x...

# Venue tuning (falls back to per-network defaults when unset):
# UNISWAP_V3_ROUTER=
# UNISWAP_V3_FEE=
# BASE_CONFIRMATIONS=

# Phase 2 — NEAR Protocol Execution & Mandates (deterministic fixture adapters by default)
# SWARAJ_NEAR_NETWORK=testnet
# Defaults to FastNEAR testnet; rpc.testnet.near.org rate-limits under real use.
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# NEAR credentials. Setting both makes permitted NEAR payments spend real funds from this
# account; without them NEAR actions use fixtures and end at cant_prove.
# NEAR_ACCOUNT_ID=agent.testnet
# NEAR_PRIVATE_KEY=ed25519:...
# Token contract for near_ft_transfer payments (near_transfer sends native NEAR):
# NEAR_FT_CONTRACT=
# Ref Finance swaps. Trades stay at cant_prove on a live account until a pool is set.
# NEAR_REF_POOL_ID=17
# NEAR_REF_CONTRACT=ref-finance-101.testnet
#
# NEAR mandate templates (trading, payment, combined, live):
# integrations/near/mandates/{trading,payment,combined,live}.json
#
# NEAR demo, against a running API with DATABASE_URL set:
# pnpm --filter @swaraj/near near-demo -- --scene=all
# Scenes: trade.allow trade.block payment.allow payment.block live.allow live.block
# NEAR_DEMO_RECIPIENT=vendor.testnet

# Human approval. Decisions need this token, which must differ from SWARAJ_DEV_TOKEN so an
# agent cannot approve itself. Unset means nothing can be approved.
# SWARAJ_APPROVER_TOKEN=

# Web2 evidence. With a secret set, Stripe payments and deploys stay pending until the provider's
# signed webhook arrives at /v1/webhooks/stripe or /v1/webhooks/github. Put the receipt id in
# metadata.swaraj_receipt_id (Stripe) or the deployment payload's swaraj_receipt_id (GitHub).
# STRIPE_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_SECRET=

# Proof pipeline (packages/proofs). SP1 toolchain: install with `sp1up`, then
# pnpm --filter @swaraj/proofs build:sp1:decision and the native-gnark host build
# (see README). Each Groth16 proof needs ~16 GB free and ~7 minutes.
# SWARAJ_SP1_HOST_BIN=
# SWARAJ_SP1_ELF=
# SWARAJ_SP1_DECISION_ELF=
# SWARAJ_SP1_VKEYS=
# SWARAJ_PROOF_ARTIFACT_ROOT=

# Settle receipts on NEAR (SWARAJ_PROOF_SINK=near selects the on-chain sink,
# fail-closed). The sink account must own the receipts contract:
# SWARAJ_PROOF_SINK=
# NEAR_SINK_ACCOUNT_ID=
# NEAR_SINK_PRIVATE_KEY=ed25519:...
# NEAR_RECEIPTS_CONTRACT_ID=

# Zunno demo (examples/zunno). None are needed for `pnpm --filter swaraj-zunno play`
# in local mode. Live gateway: ZUNNO_GATEWAY=remote plus a running API.
# ZUNNO_GATEWAY=
# ZUNNO_RPC_URL=
# ZUNNO_HOST=
# ZUNNO_GAME_ID=
# ZUNNO_WAGER_ESCROW=
# ZUNNO_LIVE_STAKE_WEI=
# ZUNNO_LIVE_OVER_STAKE_WEI=
# ZUNNO_ENCLAVE_URL=
# ZUNNO_AGENT_TOKEN=
# ZUNNO_REQUIRE_TEE=
# ZUNNO_BOT_PRIVATE_KEY=
# Shade Agent registration (needs the deployed agent contract + sponsor testnet account):
# SHADE_AGENT_CONTRACT_ID=
# SHADE_SPONSOR_ACCOUNT_ID=
# SHADE_SPONSOR_PRIVATE_KEY=ed25519:...
# SHADE_DERIVATION_PATH=
# NEAR AI Cloud private inference — get $10 free credits + an API key via the
# NEAR Builders dashboard (nearbuilders.org/dashboard) or buy at cloud.near.ai:
# NEAR_AI_API_KEY=
# NEAR_AI_MODEL=
# NEAR_AI_BASE_URL=https://cloud-api.near.ai

# Web UI (apps/web/.env): VITE_SWARAJ_URL, VITE_SWARAJ_DEV_TOKEN,
# VITE_SWARAJ_APPROVER_TOKEN, VITE_SWARAJ_APPLICATION_ID — same values as the API.

# zkVerify submission — either direct (seed phrase) or via Kurier (API key):
# ZKVERIFY_SEED_PHRASE=
# KURIER_API_KEY=
# KURIER_API_URL=https://api-testnet.kurier.xyz/api/v1
# KURIER_CHAIN_ID=84532
# SWARAJ_BASE_SEPOLIA_ZKVERIFY_CONTRACT=
# KURIER_DESTINATION_DOMAIN_ID=
# SWARAJ_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# SWARAJ_BASE_SEPOLIA_LOG_FROM_BLOCK=
# SWARAJ_PROOF_SERVICE=external

# CI flag only:
# SWARAJ_FORCE_MOCK=1
