# Live Swaraj — Base mainnet OR Base Sepolia (no silent mock).

SWARAJ_DEV_TOKEN=replace-this-development-token-with-32-random-characters
SWARAJ_URL=http://127.0.0.1:3000
SWARAJ_AGENT_KEY=replace-this-development-token-with-32-random-characters
SWARAJ_APPLICATION_ID=app_demo

POSTGRES_PASSWORD=local-development-only-change-me
DATABASE_URL=postgresql://swaraj:local-development-only-change-me@127.0.0.1:5432/swaraj

# --- Pick one network ---
# Mainnet (real USDC spend):
SWARAJ_BASE_NETWORK=base
BASE_RPC_URL=https://mainnet.base.org
# Testnet (faucet ETH + Sepolia USDC):
# SWARAJ_BASE_NETWORK=base-sepolia
# BASE_RPC_URL=https://sepolia.base.org

SWARAJ_EXECUTION_PRIVATE_KEY=0x...
SWARAJ_SIGNER_PRIVATE_KEY=0x...

# Optional overrides (defaults come from the network):
# UNISWAP_V3_ROUTER=
# UNISWAP_V3_FEE=500
# BASE_CONFIRMATIONS=

# SP1 / zkVerify / Kurier (optional for PROVED + links)
# SWARAJ_SP1_HOST_BIN=
# SWARAJ_SP1_ELF=
# SWARAJ_SP1_VKEYS=
# SWARAJ_PROOF_ARTIFACT_ROOT=
# Direct zkVerify submission (used only when KURIER_API_KEY is unset):
# ZKVERIFY_SEED_PHRASE=
# Kurier submission (pays for and relays the zkVerify transaction; no seed phrase needed).
# KURIER_API_KEY: configure securely, never commit the value.
# KURIER_API_KEY=
# KURIER_API_URL=https://api-testnet.kurier.xyz/api/v1
# Publish the proof's aggregation to Base Sepolia (only 84532 is supported). This does not select the
# trade network; SWARAJ_BASE_NETWORK does that.
# KURIER_CHAIN_ID=84532
# Base Sepolia publication check — take both values from the official zkVerify deployment docs:
# SWARAJ_BASE_SEPOLIA_ZKVERIFY_CONTRACT=
# KURIER_DESTINATION_DOMAIN_ID=
# SWARAJ_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Optional: block to start searching for the AggregationPosted log (records the Base tx hash).
# SWARAJ_BASE_SEPOLIA_LOG_FROM_BLOCK=
# Recurring proof service (started by the API when auto-prove is on; "external" if you run it yourself):
# SWARAJ_PROOF_SERVICE=external

# CI only:
# SWARAJ_FORCE_MOCK=1
