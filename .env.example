# ──────────────────────────────────────────────────────────────────────
# Swaraj environment template.
# Copy to .env and fill in real values. .env is gitignored; never commit it.
# ──────────────────────────────────────────────────────────────────────

# Local Postgres (compose.yaml). The connection string below must stay
# consistent with these three values.
POSTGRES_USER=swaraj
POSTGRES_DB=swaraj
POSTGRES_PASSWORD=choose-a-local-dev-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://swaraj:choose-a-local-dev-password@127.0.0.1:5432/swaraj

# Backend service the SDK / MCP bridge talks to.
SWARAJ_URL=http://127.0.0.1:3000
SWARAJ_DEV_TOKEN=replace-with-32-random-characters
SWARAJ_AGENT_KEY=replace-with-32-random-characters
SWARAJ_APPLICATION_ID=app_demo

# Execution venue: Base mainnet or Base Sepolia. Pick exactly one pair.
SWARAJ_BASE_NETWORK=base
BASE_RPC_URL=https://mainnet.base.org
# SWARAJ_BASE_NETWORK=base-sepolia
# BASE_RPC_URL=https://sepolia.base.org

# Signing / execution keys. Fund a dedicated test wallet; never reuse keys.
SWARAJ_EXECUTION_PRIVATE_KEY=0x...
SWARAJ_SIGNER_PRIVATE_KEY=0x...

# Venue tuning (falls back to per-network defaults when unset):
# UNISWAP_V3_ROUTER=
# UNISWAP_V3_FEE=
# BASE_CONFIRMATIONS=

# Phase 2 — NEAR (fixture adapters by default; live RPC optional later)
# SWARAJ_NEAR_NETWORK=testnet
# NEAR_RPC_URL=https://rpc.testnet.near.org
# NEAR_ACCOUNT_ID=
# NEAR_PRIVATE_KEY=
# Mandate fixtures: packages/contracts/fixtures/near-mandate-*.json
# Demo: pnpm --filter @swaraj/example near-demo -- --scene=all

# Proof pipeline (packages/proofs):
# SWARAJ_SP1_HOST_BIN=
# SWARAJ_SP1_ELF=
# SWARAJ_SP1_VKEYS=
# SWARAJ_PROOF_ARTIFACT_ROOT=

# zkVerify submission — either direct (seed phrase) or via Kurier (API key):
# ZKVERIFY_SEED_PHRASE=
# KURIER_API_KEY=
# KURIER_API_URL=https://api-testnet.kurier.xyz/api/v1
# KURIER_CHAIN_ID=84532
# SWARAJ_BASE_SEPOLIA_ZKVERIFY_CONTRACT=
# KURIER_DESTINATION_DOMAIN_ID=
# SWARAJ_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# SWARAJ_BASE_SEPOLIA_LOG_FROM_BLOCK=
# SWARAJ_PROOF_SERVICE=external

# CI flag only:
# SWARAJ_FORCE_MOCK=1
