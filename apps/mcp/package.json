{
  "name": "@swaraj/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "swaraj-mcp": "./dist/main.js",
    "swaraj-mcp-gateway": "./dist/gateway-main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm build && node dist/main.js",
    "test": "pnpm --filter @swaraj/api... build && pnpm build && node --env-file-if-exists=../../.env --test --test-concurrency 1 test/*.test.ts"
  },
  "dependencies": {
    "@swaraj/crypto": "workspace:*",
    "@swaraj/schemas": "workspace:*"
  },
  "devDependencies": {
    "@swaraj/api": "workspace:*",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
